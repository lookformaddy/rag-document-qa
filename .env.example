# Copy to .env (or export these) to override defaults.
RAGQA_CHUNK_SIZE=800
RAGQA_CHUNK_OVERLAP=150
RAGQA_EMBEDDING_PROVIDER=hashing
RAGQA_EMBEDDING_DIM=384
RAGQA_TOP_K=5
RAGQA_SIMILARITY_THRESHOLD=0.15
RAGQA_HYBRID=true
RAGQA_HYBRID_KEYWORD_WEIGHT=0.3
RAGQA_LLM_PROVIDER=extractive
# OPENAI_API_KEY=
RAGQA_OPENAI_MODEL=gpt-4o-mini
RAGQA_HOST=127.0.0.1
RAGQA_PORT=8000
